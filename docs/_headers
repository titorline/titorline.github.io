# Cloudflare Pages headers. Files in `public/` are copied verbatim to `dist/`,
# so Pages reads this at `dist/_headers`.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Security headers for every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000

# Astro emits content-hashed assets here, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
